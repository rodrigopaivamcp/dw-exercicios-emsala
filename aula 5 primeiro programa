<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Primeiro Programa</title>
</head>
<body>
    <h3>Boas Vindas</h3>
    <script type="text/javascript">
        /*OBJETIVO - Criar uma página de boas-vindas*/

        // DEFINIÇÃO DAS VARIÁVEIS
        var js_nome;

        // ENTRADA DE DADOS
        js_nome = window.prompt('Entre com o seu nome: ', 'Digite seu nome aqui');

        // SAÍDA DE DADOS
        document.write('Olá ' + js_nome + ' Seja Bem Vindo!');

    </script>
    
</body>
</html>
