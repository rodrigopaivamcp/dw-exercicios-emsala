<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Concatenação</title>
</head>
<body>
    <h3>Boas vindas com Concatenação de Campos</h3>

    <!--DEFINIÇÃO DO FORMULÁRIO-->
    <form name="FormConcatena" action="mailto:rodrigo.mcpaiva@sempreceub.com" method="post">
        Digite o nome .........: <input type="text" name="f_nome">
        <br>
        <br>
        Digite o sobrenome .........: <input type="text" name="f_sobrenome">
        <br>
        <br>
        <input type="button" name="btn_concatena" value="Concatenar" onclick="concatena()">
        <input type="reset" name="btn_cancelar" value="Cancelar">

    </form>

    <!-- CRIAÇÃO DO JAVA SCRIPT -->
    <script type="text/javascript">
        // OBJETIVO: capturar nome e sobrenome e concatenar formando um nome completo
        
        
        // DEFINIÇÃO DE VARIÁVEIS 
        var js_nome;
        var js_sobrenome;
        var js_nomecompleto;

        function concatena(){
            // ENTRADA DE DADOS
            js_nome = document.FormConcatena.f_nome.value;
            js_sobrenome = document.FormConcatena.f_sobrenome.value;

            //PROCESSAMENTO DE DADOS 
            js_nomecompleto = js_nome+ ' ' + js_sobrenome;

            //SAÍDA DE DADOS
            window.alert('Olá ' +js_nomecompleto);
        }

    </script>
</body>
</html>
